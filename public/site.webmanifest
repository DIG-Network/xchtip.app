{
  "name": "xchtip.app — Chia tip buttons",
  "short_name": "xchtip.app",
  "description": "Embeddable Chia tip buttons for XCH or any CAT. On-chain, wallet to wallet.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b1512",
