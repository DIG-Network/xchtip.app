{
  "name": "xchtip-app",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "xchtip.app — embeddable Chia tip-widget builder (XCH or any CAT, incl. $DIG)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/gen-seo-files.mjs && node scripts/inject-embed-config.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@dignetwork/components": "^0.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "^6.8.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
